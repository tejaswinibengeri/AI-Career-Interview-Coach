# =============================================================================
# AI Career & Interview Coach — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/career_coach
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/career_coach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=career_coach

# --- Security ---
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Ollama AI ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Application ---
APP_NAME=AI Career & Interview Coach
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- External Job Provider (Job Market Analyzer) ---
# Sign up for free at https://developer.adzuna.com/ to get your App ID and App Key
ADZUNA_APP_ID=3510f190
ADZUNA_APP_KEY=6c8f1f8090a309a90dff9d3e4cc69e97
ADZUNA_COUNTRY=in
# Alternatively, use generic provider settings:
JOB_PROVIDER_API_ID=3510f190
JOB_PROVIDER_API_KEY=6c8f1f8090a309a90dff9d3e4cc69e97
JOB_PROVIDER_URL=https://developer.adzuna.com/admin/access_details

# --- Email / SMTP Notifications ---
# Set SMTP_ENABLED=true to enable task completion and daily summary emails.
# For Gmail: use an App Password (Google Account → Security → App Passwords)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=CareerCoachAI
REMINDER_MORNING_TIME=07:00
REMINDER_EVENING_TIME=20:00
REMINDER_TIMEZONE=Asia/Kolkata
