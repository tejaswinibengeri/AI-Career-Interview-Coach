# --- Database (SQLite default for zero-configuration instant local run) ---
DATABASE_URL=sqlite+aiosqlite:///./career_coach.db
DATABASE_URL_SYNC=sqlite:///./career_coach.db

# --- Security ---
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Ollama AI ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Google Gemini AI ---
# Set GEMINI_API_KEY to automatically switch from Ollama → Gemini (better accuracy).
# Leave empty to keep using Ollama. Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173"]

# --- Application ---
APP_NAME=AI Career & Interview Coach
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- Email / SMTP Notifications (Optional) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CareerCoachAI
REMINDER_MORNING_TIME=07:00
REMINDER_EVENING_TIME=20:00
REMINDER_TIMEZONE=Asia/Kolkata
